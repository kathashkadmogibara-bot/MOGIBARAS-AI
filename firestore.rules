rules_version = '2';

service cloud.firestore {

  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }


    /*
      USER PROFILES
    */

    match /users/{userId} {

      allow create:
        if signedIn()
        && request.auth.uid == userId;

      allow read, update:
        if signedIn()
        && request.auth.uid == userId;

      allow delete:
        if false;
    }


    /*
      AI KNOWLEDGE

      Everyone logged in can read.
      Logged-in users can add training.
    */

    match /aiKnowledge/{knowledgeId} {

      allow read:
        if signedIn();

      allow create:
        if signedIn();

      allow update:
        if signedIn();

      allow delete:
        if false;
    }


    /*
      TRAINING RECORDS
    */

    match /trainingRecords/{recordId} {

      allow create:
        if signedIn()
        && request.resource.data.userId
           == request.auth.uid;

      allow read:
        if signedIn()
        && resource.data.userId
           == request.auth.uid;

      allow update, delete:
        if false;
    }


    /*
      CHAT HISTORY
    */

    match /history/{historyId} {

      allow create:
        if signedIn()
        && request.resource.data.userId
           == request.auth.uid;

      allow read:
        if signedIn()
        && resource.data.userId
           == request.auth.uid;

      allow update, delete:
        if false;
    }

  }
}
